{
	"name": "api",
	"version": "0.0.0",
	"private": true,
	"description": "Example NestJS app exercising nestjs-drizzle-crud. Doubles as the e2e testbed, run by Playwright against an in-process Postgres (PGlite).",
	"scripts": {
		"prebuild": "rm -rf dist *.tsbuildinfo",
		"build": "tsc -p tsconfig.build.json",
		"start": "PORT=4000 node dist/main.js",
		"dev": "tsc -p tsconfig.build.json && (tsc -p tsconfig.build.json --watch --preserveWatchOutput & PORT=4000 node --watch dist/main.js)",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"test": "playwright test",
		"lint": "biome lint src e2e",
		"test:ui": "playwright test --ui"
	},
	"dependencies": {
		"@nestjs/common": "^11.1.28",
		"@nestjs/config": "^4.0.2",
		"@nestjs/core": "^11.1.28",
		"@nestjs/platform-express": "^11.1.28",
		"@nestjs/swagger": "^11.4.7",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.14.1",
		"drizzle-orm": "^0.45.2",
		"@avytrix/nestjs-drizzle-crud": "workspace:*",
		"postgres": "^3.4.9",
		"reflect-metadata": "^0.2.0",
		"rxjs": "^7.8.1"
	},
	"devDependencies": {
		"@electric-sql/pglite": "^0.5.4",
		"@playwright/test": "^1.62.1",
		"@types/node": "^26.0.0",
		"typescript": "^7.0.0"
	}
}
