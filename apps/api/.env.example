# Postgres connection string consumed by DrizzleCrudModule.forRootAsync.
# postgres-js reads sslmode from the URL, so no extra TLS config is needed.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# `pglite` runs an in-process Postgres (WASM) seeded with the e2e fixture in
# src/db/pglite.ts. That is what the Playwright suite uses, so `pnpm test` needs
# no server and no credentials. Use it for a throwaway local run too:
# DATABASE_URL=pglite

# Optional: HTTP port (defaults to 4000; the e2e server uses E2E_PORT, 4100)
# PORT=4000
