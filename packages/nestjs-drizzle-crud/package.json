{
	"name": "@avytrix/nestjs-drizzle-crud",
	"version": "3.7.2",
	"description": "NestJS + Drizzle ORM CRUD: type-safe services with filtering, pagination, cursor pagination, relations, soft delete, upsert, multi-tenancy and OpenAPI for PostgreSQL, MySQL and SQLite.",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"bin": {
		"nestjs-drizzle-crud-mcp": "dist/mcp/server.js"
	},
	"files": [
		"dist/**/*",
		"README.md",
		"AGENT.md",
		"AGENTS.template.md",
		"CLAUDE.template.md",
		"CHANGELOG.md",
		"LICENSE"
	],
	"scripts": {
		"prebuild": "rm -rf dist *.tsbuildinfo",
		"build": "tsc -p tsconfig.build.json",
		"build:watch": "tsc -p tsconfig.build.json --watch",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"prepublishOnly": "pnpm run build && pnpm test",
		"release": "pnpm publish --access public --no-git-checks",
		"test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
		"test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
		"test:cov": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
		"lint": "biome lint src",
		"format": "biome format --write src"
	},
	"keywords": [
		"nestjs",
		"drizzle",
		"drizzle-orm",
		"crud",
		"nestjs-crud",
		"nestjs-drizzle",
		"rest-api",
		"pagination",
		"cursor-pagination",
		"filtering",
		"soft-delete",
		"multi-tenant",
		"upsert",
		"openapi",
		"swagger",
		"postgresql",
		"mysql",
		"sqlite",
		"libsql",
		"typescript",
		"mcp",
		"rest",
		"api",
		"database",
		"orm",
		"eager-loading",
		"n+1",
		"multi-tenancy"
	],
	"author": "Suman Bonakurthi <sumanbonakurthi@gmail.com>",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/avytrix/nestjs-drizzle-crud.git",
		"directory": "packages/nestjs-drizzle-crud"
	},
	"bugs": {
		"url": "https://github.com/avytrix/nestjs-drizzle-crud/issues"
	},
	"homepage": "https://crud.avytrix.dev",
	"funding": {
		"type": "github",
		"url": "https://github.com/sponsors/avytrix"
	},
	"peerDependencies": {
		"@nestjs/common": ">=10.0.0",
		"@nestjs/core": ">=10.0.0",
		"@nestjs/swagger": ">=7.0.0",
		"drizzle-orm": ">=0.28.0 <1.0.0",
		"mysql2": ">=3.0.0",
		"postgres": ">=3.0.0",
		"reflect-metadata": "^0.1.13 || ^0.2.0"
	},
	"peerDependenciesMeta": {
		"@nestjs/swagger": {
			"optional": true
		},
		"mysql2": {
			"optional": true
		},
		"postgres": {
			"optional": true
		}
	},
	"devDependencies": {
		"@electric-sql/pglite": "^0.5.4",
		"@jest/globals": "^30.0.0",
		"@libsql/client": "^0.18.0",
		"@nestjs/common": "^11.1.28",
		"@nestjs/core": "^11.1.28",
		"@nestjs/swagger": "^11.4.7",
		"@nestjs/testing": "^11.1.28",
		"@swc/core": "^1.7.0",
		"@swc/jest": "^0.2.37",
		"@types/jest": "^30.0.0",
		"@types/node": "^26.0.0",
		"drizzle-orm": "^0.45.2",
		"jest": "^30.4.2",
		"mysql2": "^3.24.6",
		"postgres": "^3.4.9",
		"reflect-metadata": "^0.2.0",
		"typescript": "^7.0.0"
	},
	"engines": {
		"node": ">=20.0.0"
	}
}
