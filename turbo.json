{
	"$schema": "https://turbo.build/schema.json",
	"ui": "stream",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**", ".next/**", "!.next/cache/**", "out/**"]
		},
		"test": {
			"dependsOn": ["^build"],
			"outputs": ["coverage/**", "playwright-report/**"],
			"env": ["E2E_PORT"]
		},
		"typecheck": {
			"dependsOn": ["^build"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		}
	}
}
