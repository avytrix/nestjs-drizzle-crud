{
	"name": "nestjs-drizzle-crud-monorepo",
	"version": "0.0.0",
	"private": true,
	"description": "Monorepo for nestjs-drizzle-crud — the published library, its documentation site, and an example NestJS app used as the e2e testbed.",
	"packageManager": "pnpm@10.28.1",
	"engines": {
		"node": ">=20.0.0"
	},
	"scripts": {
		"build": "turbo run build",
		"test": "turbo run test",
		"typecheck": "turbo run typecheck",
		"dev": "turbo run dev --filter=nestjs-drizzle-crud-docs",
		"dev:api": "turbo run dev --filter=api",
		"dev:all": "turbo run dev",
		"lint": "biome lint .",
		"format": "biome format --write .",
		"release": "pnpm --filter nestjs-drizzle-crud release"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.4",
		"turbo": "^2.10.5",
		"typescript": "^7.0.0"
	}
}
